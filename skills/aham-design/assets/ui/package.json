{
  "name": "aham-design-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Aham Design 界面部分：业务管理系统的样式、行为脚本、规则和组件契约，取值来自插件根目录的 tokens.json。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./aham.d.ts",
      "default": "./aham.js"
    },
    "./aham.js": {
      "types": "./aham.d.ts",
      "default": "./aham.js"
    },
    "./aham.css": "./aham.css",
    "./assets/*": "./assets/*"
  },
  "types": "./aham.d.ts",
  "files": [
    "aham.css",
    "aham.js",
    "aham.d.ts",
    "assets/",
    "components/",
    "scripts/product-check.mjs",
    "rules/",
    "设计理念.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/lint.mjs && node scripts/contracts.mjs && node scripts/theme.mjs --check && node --test",
    "test:browser": "node qa/run-browser.mjs",
    "shots": "node qa/screenshots.mjs",
    "lab": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
