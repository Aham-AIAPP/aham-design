{
  "schema_version": "2.0",
  "rules_id": "aham-writing-rules",
  "description": "Aham 文档写作规则：禁用词、口语词、标题写法、编号。排版引擎读其中的编号规则。",
  "banned_words": [
    "承接",
    "赋能",
    "沉淀",
    "落地",
    "抓手",
    "闭环",
    "颗粒度",
    "粒度",
    "归集",
    "收敛",
    "下沉",
    "对位",
    "波次",
    "地基",
    "命脉",
    "灰度",
    "旁路",
    "水位",
    "卡位",
    "对齐",
    "打通",
    "落库",
    "原生",
    "前置",
    "全域"
  ],
  "banned_word_allowed_contexts": {
    "对齐": [
      "核对齐套"
    ],
    "对位": [
      "相对位"
    ],
    "落地": [
      "角落地"
    ]
  },
  "it_jargon": [
    "上下文",
    "下钻",
    "心跳",
    "埋点"
  ],
  "spoken_words": [
    "干活",
    "坐下来",
    "露馅",
    "放水",
    "做砸",
    "硬推",
    "松口",
    "长什么样",
    "随手",
    "齐刷刷"
  ],
  "spoken_words_manual": [
    "活",
    "兜"
  ],
  "placeholders": [
    "张三",
    "李四",
    "Lorem ipsum",
    "lorem ipsum",
    "ABC-001",
    "test123",
    "TODO",
    "FIXME",
    "XXX-"
  ],
  "chrome_words": [
    "待客户确认",
    "客户核验",
    "草稿",
    "未签署",
    "内部测算",
    "送审",
    "内审",
    "待商务审批",
    "内部稿",
    "内部资料"
  ],
  "heading_forbidden_endings": [
    "是什么",
    "做什么",
    "做成什么样",
    "差在哪",
    "在哪里",
    "怎么办",
    "怎么做",
    "怎么答",
    "带什么",
    "先问什么",
    "多少",
    "几次",
    "为什么",
    "哪些",
    "如何"
  ],
  "heading_forbidden_tokens": [
    "你",
    "您",
    "请"
  ],
  "ai_phrases_opening": [
    "值得注意的是",
    "需要指出的是",
    "重要的是",
    "事实上",
    "坦白说",
    "说实话"
  ],
  "ai_phrases_contrast": [
    {
      "label": "不是……而是",
      "pattern": "不是[^。；！？]{1,20}而是"
    },
    {
      "label": "……，而非……",
      "pattern": "[^，。；]{1,12}，而非"
    },
    {
      "label": "与其说……不如说",
      "pattern": "与其说.{1,20}不如说"
    },
    {
      "label": "不……，只……",
      "pattern": "不[^，。；]{1,12}，只[^，。；]{1,12}"
    }
  ],
  "ai_phrases_closing": [
    "结论：",
    "简而言之",
    "总而言之",
    "总的来说",
    "一句话总结",
    "最简单的理解方式是"
  ],
  "sentence_max_chars": 60,
  "sentence_terminators": "。！？；",
  "page_text": {
    "subheading_max_chars": 20,
    "item_max_chars": 18
  },
  "numbering": {
    "levels": [
      "一、",
      "（一）",
      "1.",
      "（1）"
    ],
    "list": "1.",
    "sublist": "（1）",
    "basis": "GB/T 9704-2012 第 7.3.3 条：结构层次序数依次可以用「一、」「（一）」「1.」「（1）」标注"
  },
  "pending_markers": [
    "待确认",
    "TBC",
    "待定"
  ],
  "evidence_limit": 10
}
