{
  "$meta": {
    "name": "aham-design",
    "version": "1.0.0",
    "$description": "Aham 系列全部视觉取值的唯一来源：颜色、字体、字号、线宽、圆角、阴影和版面。Word、Excel、PPT、网页、界面和公众号都从这里读。写法借用 DTCG 设计令牌格式的键名：$value 是取值，$description 是用途，$type 是类型；值写成 {组.名} 时引用本文件另一个取值。色值写 #RRGGBB。本文件不是完整的 DTCG 文件：字号的单位写在组说明里。"
  },
  "color": {
    "$description": "颜色。色值写成 #RRGGBB。$extensions.contrast 写明该色的最低对比度要求和对比的底色，测试按它检查。",
    "$type": "color",
    "blue": {
      "$description": "品牌蓝阶。文档里的蓝字一律用 text：base 在浅灰底 gray.1 上只有 4.35:1。",
      "base": {
        "$value": "#336EE8",
        "$description": "品牌蓝：logo、主按钮底色（白字）、图形、焦点框。不作文档正文里的蓝字",
        "$extensions": {
          "contrast": {
            "min": 4.5,
            "on": "{color.gray.0}"
          }
        }
      },
      "hover": {
        "$value": "#2A62D6",
        "$description": "主按钮悬停",
        "$extensions": {
          "contrast": {
            "min": 4.5,
            "on": "{color.gray.0}"
          }
        }
      },
      "text": {
        "$value": "#2453C7",
        "$description": "文档蓝字、链接、主按钮按下",
        "$extensions": {
          "contrast": {
            "min": 4.5,
            "on": "{color.gray.0}"
          }
        }
      },
      "strong": {
        "$value": "#1C45AC",
        "$description": "文档里需要加重的蓝字",
        "$extensions": {
          "contrast": {
            "min": 4.5,
            "on": "{color.gray.0}"
          }
        }
      },
      "bg": {
        "$value": "#EEF2FC",
        "$description": "浅蓝底：蓝色提示框、选中行底色"
      },
      "dark": {
        "$value": "#6C97F0",
        "$description": "深色模式的蓝字和图形。深色模式的主按钮底色仍用 base",
        "$extensions": {
          "contrast": {
            "min": 4.5,
            "on": "{color.gray_dark.bg}"
          }
        }
      }
    },
    "gray": {
      "$description": "冷灰阶，浅色。档号越大越深，色相统一为 OKLCH 260°。0—10 是底色和线，11—12 是图形，13—18 是文字。",
      "0": {
        "$value": "#FFFFFF",
        "$description": "页面底、界面面板底"
      },
      "1": {
        "$value": "#F6F8FB",
